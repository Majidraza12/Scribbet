{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribbet",
  "version": "1.2.2",
  "identifier": "dev.scribbet.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Scribbet",
        "width": 150,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Scribbet",
    "category": "Productivity",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "shortDescription": "Local-first dictation for Windows.",
    "longDescription": "Scribbet turns speech into text in any Windows app — fully on-device. No cloud, no account, no telemetry. Press a hotkey, talk, and clean text lands at your caret.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
